# Use sandbox credentials and matching sandbox prices during development.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_YEARLY=

# RevenueCat (primary in-app subscriptions). Secret key: RevenueCat > Project
# settings > API keys > Secret API key (sk_...). Never ship it in the app.
REVENUECAT_SECRET_API_KEY=
# Entitlement identifier that unlocks Pro (RevenueCat > Entitlements).
REVENUECAT_ENTITLEMENT_ID=pro
# Any long random string; paste the same value as the webhook Authorization
# header in RevenueCat > Integrations > Webhooks. Webhook URL:
#   https://<backend>/api/payment/revenuecat/webhook
REVENUECAT_WEBHOOK_AUTH=
# Optional: RevenueCat Web Purchase Link (RevenueCat > Web > Web Purchase Links),
# e.g. https://pay.rev.cat/<token>. Enables Pro checkout on the website; the
# signed-in user's ID is appended automatically. Public value, not a secret.
REVENUECAT_WEB_PURCHASE_URL=

# Optional: storage quota for the live DB card (M0 free tier = 512).
MONGODB_STORAGE_LIMIT_MB=512
# Optional: extra allowed CORS origins, comma-separated.
CORS_EXTRA_ORIGINS=
# Website base URL used in password-reset and account-deletion emails.
FRONTEND_URL=https://nutrimorph.app
